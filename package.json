{
  "name": "herald",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./opencode-plugin/index.ts",
    "./tui": "./opencode-plugin/tui.ts"
  },
  "scripts": {
    "check": "pwsh -NoProfile -File development_tools/check.ps1",
    "setup:checks": "pwsh -NoProfile -File development_tools/setup-checks.ps1",
    "lint": "oxlint opencode-plugin claude-plugin/hooks claude-plugin/tests development_tools --deny-warnings",
    "typecheck": "tsc --noEmit && tsc --noEmit -p claude-plugin/tsconfig.json",
    "test": "bun test ./opencode-plugin/tests",
    "test:claude": "claude plugin test ./claude-plugin",
    "test:tools": "pwsh -NoProfile -File development_tools/test-tools.ps1",
    "test:verification": "pwsh -NoProfile -File development_tools/test-verification-process.ps1",
    "test:hosts": "pwsh -NoProfile -File .claude/skills/verify-herald/scripts/hosts.ps1",
    "build:announcer": "node development_tools/build-announcer.mjs",
    "build:bundle": "pwsh -NoProfile -File development_tools/build-bundle.ps1",
    "test:bundle": "pwsh -NoProfile -File development_tools/test-bundle.ps1 && bun test development_tools/tests/registration.test.mjs",
    "test:bundle:installed": "pwsh -NoProfile -File .claude/skills/verify-herald/scripts/install-bundle.ps1",
    "deploy:plugins": "pwsh -NoProfile -File development_tools/deploy-plugins.ps1",
    "test:companion": "cargo test --locked --manifest-path native-announcer/Cargo.toml",
    "test:windows": "pwsh -NoProfile -File development_tools/verify-announcer.ps1",
    "test:settings": "pwsh -NoProfile -File development_tools/verify-settings-gpui.ps1",
    "test:characters": "pwsh -NoProfile -File development_tools/verify-settings-gpui.ps1 -Feature Characters",
    "benchmark:settings": "pwsh -NoProfile -File development_tools/benchmark-settings-memory.ps1",
    "test:assets": "node --test development_tools/tests/assets.test.mjs development_tools/tests/linux-menu.test.mjs",
    "install:linux-menu": "node development_tools/install-linux-menu.mjs",
    "test:settings:linux": "python3 development_tools/verify-linux-settings.py",
    "test:settings:layout:linux": "python3 development_tools/verify-linux-settings.py --layout",
    "test:settings:keyboard:linux": "python3 development_tools/verify-linux-settings.py --keyboard",
    "profile:plugin": "bun development_tools/profile-plugin.ts"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.292",
    "@types/bun": "1.4.2",
    "@types/node": "^22.0.0",
    "jsonc-parser": "3.3.1",
    "oxlint": "^1.0.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@opencode/client": ">=2.0.24",
    "@opencode/plugin": ">=2.0.23",
    "solid-js": ">=1.9.0"
  }
}
