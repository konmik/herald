{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/herald.mjs\"",
            "commandWindows": "node -e \"process.argv[1]=require('node:path').join(process.env.PLUGIN_ROOT,'hooks','herald.mjs');import(require('node:url').pathToFileURL(process.argv[1]).href)\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/herald.mjs\"",
            "commandWindows": "node -e \"process.argv[1]=require('node:path').join(process.env.PLUGIN_ROOT,'hooks','herald.mjs');import(require('node:url').pathToFileURL(process.argv[1]).href)\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/herald.mjs\"",
            "commandWindows": "node -e \"process.argv[1]=require('node:path').join(process.env.PLUGIN_ROOT,'hooks','herald.mjs');import(require('node:url').pathToFileURL(process.argv[1]).href)\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Agent|spawn_agent|collaborationspawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/herald.mjs\"",
            "commandWindows": "node -e \"process.argv[1]=require('node:path').join(process.env.PLUGIN_ROOT,'hooks','herald.mjs');import(require('node:url').pathToFileURL(process.argv[1]).href)\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Agent|spawn_agent|collaborationspawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/herald.mjs\"",
            "commandWindows": "node -e \"process.argv[1]=require('node:path').join(process.env.PLUGIN_ROOT,'hooks','herald.mjs');import(require('node:url').pathToFileURL(process.argv[1]).href)\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/herald.mjs\"",
            "commandWindows": "node -e \"process.argv[1]=require('node:path').join(process.env.PLUGIN_ROOT,'hooks','herald.mjs');import(require('node:url').pathToFileURL(process.argv[1]).href)\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/herald.mjs\"",
            "commandWindows": "node -e \"process.argv[1]=require('node:path').join(process.env.PLUGIN_ROOT,'hooks','herald.mjs');import(require('node:url').pathToFileURL(process.argv[1]).href)\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
